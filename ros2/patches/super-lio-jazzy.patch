+void check(bool ok,const char* msg){if(!ok)throw std::runtime_error(msg);}
+IMUData sample(double t,bool varying=false){IMUData d;d.secs=t;d.acc=V3(0,0,g_gravity_norm);d.gyr=V3(0,0,varying?.2+.5*t:1.);return d;}
+void init(ESKF& f,bool varying=false){
+ f.SetInitialConditions(ESKF::Options(),V3::Zero(),V3::Zero(),1.,V3(0,0,-g_gravity_norm));
+ auto state=f.GetSysState();state.timestamp=0;f.SetX(state);f.PrimeIMU(sample(0,varying),0);f.init_=true;
+}
+int main(){
+ ESKF f;init(f);f.SetObsTime(.095);
+ for(int i=1;i<=10;++i)f.Predict(sample(i*.01));
+ check(std::abs(f.GetTime()-.095)<1e-12,"did not reach scan end");
+ check(std::abs(f.GetNavState().R.log_vee()[2]-.095)<1e-6,"lost boundary rotation");
+ f.SetLastObsTime(.095);f.SetObsTime(.195);
+ // The look-ahead sample at .10 was not consumed by the queue.
+ for(int i=10;i<=20;++i)f.Predict(sample(i*.01));
+ check(std::abs(f.GetTime()-.195)<1e-12,"second scan did not reach endpoint");
+ check(std::abs(f.GetNavState().R.log_vee()[2]-.195)<1e-6,"dropped or duplicated interval remainder");
+ const double old_time=f.GetTime();f.SetObsTime(1.0);
+ check(!f.Predict(sample(1.0))&&f.GetTime()==old_time,"integrated an unbounded IMU gap");
+ ESKF delayed;init(delayed,true);DynamicState output,robot;
+ for(int i=1;i<=35;++i)delayed.Predict(sample(i*.01,true),output,robot);
+ delayed.SetObsTime(.095);
+ for(int i=1;i<=10;++i)delayed.Predict(sample(i*.01,true));
+ delayed.UpdateObserve([](const ESKF::KFState&,M6& H,V6& r){H.setZero();r.setZero();});
+ check(delayed.Predict(sample(.36,true),output,robot),"delayed correction stalled high-frequency output");
+ const double expected=.2*.36+.25*.36*.36;
+ SO3 rotation;rotation.R_=output.R;

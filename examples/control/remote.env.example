# Copy to configs/remote.env on the client host. Sourced by Bash.
RSIM_CONDA_SH=
RSIM_CONDA_ENV=
RSIM_CHASSIS_NAME=chassis
RSIM_DDS_DOMAIN=42
RSIM_DDS_LOCAL_IP="<client-routable-ip>"
RSIM_DDS_PEER_IP="<hardware-host-routable-ip>"
## Optional: reachable external address of a port-preserving NAT mapping.
## Keep LOCAL_IP set to an address that belongs to this machine.
# RSIM_DDS_EXTERNAL_IP="<mapped-client-ip>"
RSIM_KEYBOARD_CONFIG=examples/control/keyboard.example.yaml
# Preserve DISPLAY supplied by WSLg or SSH; do not set it to a fixed value here.

# Copy to configs/hardware.env on the machine running this process. Sourced by Bash.
RSIM_CONDA_SH=
RSIM_CONDA_ENV=
ROS_DOMAIN_ID=0
RSIM_STM32_PORT="/dev/serial/by-id/your-stm32"
RSIM_IMU_PORT="/dev/serial/by-id/your-body-imu"
RSIM_BLUESEA_PORT="/dev/serial/by-id/your-bluesea"
RSIM_HARDWARE_MOTION=false
# Extra native arguments are Bash arrays, preserving each argument.
STM32_ROS_ARGS=(-p max_linear:=0.25 -p max_angular:=0.5)
IMU_ROS_ARGS=()
BLUESEA_ROS_ARGS=()
